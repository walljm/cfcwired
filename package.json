{
  "name": "cfcwired",
  "version": "1.0.0",
  "description": "CFC Wired website for RockRMS",
  "scripts": {
    "build:css": "lessc src/less/styles.less src/css/styles.css",
    "watch:css": "chokidar \"src/less/**/*.less\" -c \"npm run build:css\"",
    "build": "npm run build:css",
    "serve": "serve src -p 3000",
    "dev": "concurrently \"npm run watch:css\" \"npm run serve\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "chokidar-cli": "^3.0.0",
    "less": "^4.2.0",
    "serve": "^14.2.1"
  },
  "keywords": [
    "cfcwired",
    "rockrms",
    "bootstrap"
  ],
  "author": "",
  "license": "MIT"
}
