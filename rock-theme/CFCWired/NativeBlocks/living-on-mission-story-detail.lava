{% comment %}
  Living on Mission Story — Detail
  Rock block: Content Channel Item View
  Channel:    Living on Mission Stories
  Renders one story at /community/{Item} where {Item} is the StorySlug or item id.
  Pairs with the listing Lava `living-on-mission-stories.lava`.
{% endcomment %}

{% if Item == empty %}
    <section class="py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <h1 class="fw-bold text-uppercase mb-3">Story Not Found</h1>
                    <p>We couldn&rsquo;t find that story. <a href="/get-involved/living-on-mission">Return to Living on Mission</a>.</p>
                </div>
            </div>
        </div>
    </section>
{% else %}
    {% assign image = Item | Attribute:'Image','RawValue' %}
    {% assign storySlug = Item | Attribute:'StorySlug' %}
    {% assign external = Item | Attribute:'ExternalUrl' %}

    <section class="page-hero text-white py-5 lom-story-hero"{% if image != '' %} style="background-image: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('{{ image | ImageUrl }}'); background-size: cover; background-position: center;"{% endif %}>
        <div class="container py-4 text-center">
            <div class="lom-story-eyebrow text-uppercase mb-2">Living on Mission</div>
            <h1 class="display-4 fw-bold text-uppercase mb-0">{{ Item.Title }}</h1>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9 lom-story-body">
                    {% if Item.StartDateTime != null and Item.StartDateTime != '' %}
                        <div class="lom-story-date text-uppercase mb-3">{{ Item.StartDateTime | Date:'MMMM d, yyyy' }}</div>
                    {% endif %}
                    {{ Item.Content }}

                    <div class="lom-story-footer mt-5 pt-4">
                        <a href="/get-involved/living-on-mission" class="btn btn-primary">&larr; All Stories</a>
                        {% if external != '' %}
                            <a href="{{ external }}" target="_blank" rel="noopener" class="btn btn-default">View Original</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endif %}
