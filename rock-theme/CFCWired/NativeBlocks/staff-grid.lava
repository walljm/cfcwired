<div class="row g-4">
{% for item in Items %}
    <div class="col-md-4 col-sm-6">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
            <div class="card-body">
                {% assign photo = item | Attribute:'Photo','RawValue' %}
                {% if photo != '' %}
                    <img src="{{ photo | ImageUrl }}" class="img-responsive rounded-circle mx-auto mb-3" alt="{{ item.Title }}" style="width: 150px; height: 150px; object-fit: cover;">
                {% else %}
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 150px; height: 150px; background: #f0f0f0;">
                        <i class="fa fa-user fa-3x text-muted"></i>
                    </div>
                {% endif %}
                <h4 class="card-title text-uppercase mb-1">{{ item.Title }}</h4>
                <p class="text-muted mb-0">{{ item | Attribute:'Role' }}</p>
                {% if item.Content != '' %}
                    <div class="small text-muted mt-3">{{ item.Content }}</div>
                {% endif %}
            </div>
        </div>
    </div>
{% endfor %}
</div>
